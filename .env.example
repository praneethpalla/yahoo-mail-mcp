# Yahoo Mail MCP Server Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# =============================================================================
# REQUIRED: Yahoo Mail Credentials
# =============================================================================

# Your Yahoo Mail email address
YAHOO_EMAIL=your.email@yahoo.com

# Yahoo Mail app-specific password (16 characters)
# Generate at: https://login.yahoo.com/account/security/app-passwords
# Instructions:
#   1. Go to https://login.yahoo.com/account/security
#   2. Click "Generate app password" or "Manage app passwords"
#   3. Select "Other App" and enter "MCP Server"
#   4. Copy the generated 16-character password
# The app password is NEVER stored in this file. Put it in a password store and set a command that prints it.
# macOS Keychain (store it first; you'll be prompted for the password, hidden):
#   security add-generic-password -a you@yahoo.com -s yahoo-mail-mcp -T "" -w
YAHOO_APP_PASSWORD_COMMAND=security find-generic-password -a you@yahoo.com -s yahoo-mail-mcp -w
# Windows Credential Manager (store it first: powershell -NoProfile -ExecutionPolicy Bypass -File scripts\windows-credential.ps1 -Set -User you@yahoo.com):
#   YAHOO_APP_PASSWORD_COMMAND=powershell -NoProfile -ExecutionPolicy Bypass -File "C:\path\to\yahoo-mail-mcp\scripts\windows-credential.ps1"
# Other stores: op read "op://Private/Yahoo MCP/password" | secret-tool lookup service yahoo-mail-mcp | pass show yahoo-mail-mcp
# Docker: cat /run/secrets/yahoo-app-password     Render: cat /etc/secrets/yahoo-app-password
# The server refuses to start if a plain YAHOO_APP_PASSWORD is set.

# =============================================================================
# TRANSPORT MODE (for local development)
# =============================================================================

# Choose transport mode:
#   - stdio: For local desktop use with Claude Desktop
#   - sse: For HTTP/SSE mode (required for Render.com deployment)
TRANSPORT_MODE=stdio

# Port for SSE mode (only used when TRANSPORT_MODE=sse)
PORT=3000

# =============================================================================
# OPTIONAL: OAuth2 Credentials
# =============================================================================

# If you want to use OAuth2 instead of app passwords (advanced)
# YAHOO_CLIENT_ID=your_client_id
# YAHOO_CLIENT_SECRET=your_client_secret

# =============================================================================
# SECURITY (REQUIRED for production!)
# =============================================================================

# OAuth 2.0 Client Credentials - REQUIRED to secure your MCP server!
# Generate strong random credentials:
#   Client ID: openssl rand -hex 16
#   Client Secret: openssl rand -hex 32
# Configure these in Claude Desktop > Settings > Connectors > Advanced Settings
OAUTH_CLIENT_ID=your-client-id-here
OAUTH_CLIENT_SECRET=your-client-secret-here

# Sign-in for connecting apps (required in HTTP mode). Create these with:
#   npm run setup-login -- --out ~/yahoo-mcp-login.txt
# AUTH_USERNAME=
# AUTH_PASSWORD_HASH=scrypt$...        (a hash, never the plain password)
# AUTH_TOTP_SECRET=                    (recommended: adds a 6-digit authenticator code)

# Behind a proxy such as Render, trust it so sign-in lockouts apply per client address:
# TRUST_PROXY=1

# Allow the client_credentials grant, which skips the sign-in page (trusted machine-to-machine use only):
# ALLOW_CLIENT_CREDENTIALS=true

# Token lifetimes in seconds (defaults: access 1 hour, refresh 30 days).
# Changing OAUTH_CLIENT_SECRET invalidates every issued token.
# OAUTH_ACCESS_TOKEN_TTL=3600
# OAUTH_REFRESH_TOKEN_TTL=2592000

# HTTP mode refuses to start without OAUTH_CLIENT_ID/OAUTH_CLIENT_SECRET and AUTH_USERNAME/AUTH_PASSWORD_HASH.
# For local testing only, you can allow it anyway (anyone who can reach the server can use the mailbox):
# ALLOW_UNAUTHENTICATED=true

# Extra hostnames allowed as OAuth redirect targets, comma-separated (default: claude.ai,claude.com).
# Add the host of any other MCP client you connect, e.g. chatgpt.com. localhost is always allowed.
# OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com

# =============================================================================
# PRODUCTION SETTINGS (for Render.com)
# =============================================================================

# When deploying to Render.com, set these in the Render Dashboard:
#   - YAHOO_EMAIL
#   - Secret File "yahoo-app-password" (the app password); render.yaml sets YAHOO_APP_PASSWORD_COMMAND to read it
#   - TRANSPORT_MODE=http   (serves Streamable HTTP at /mcp and legacy SSE at /mcp/sse; "sse" also works)
#   - OAUTH_CLIENT_ID (generate with: openssl rand -hex 16)
#   - OAUTH_CLIENT_SECRET (generate with: openssl rand -hex 32)
#   - PORT (automatically set by Render)
#   - NODE_ENV=production (automatically set)